{
  "name": "pocketmate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pocketmate/client",
    "build": "npm run build -w @pocketmate/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fuzz": "tsx tools/fuzz.ts",
    "golden": "tsx tools/golden.ts",
    "arena": "tsx tools/ai-arena.ts",
    "verify": "tsx tools/verify.ts",
    "import-cards": "tsx tools/import-tcgdex.ts",
    "coverage": "tsx tools/card-coverage.ts",
    "server": "tsx packages/server/src/main.ts",
    "build:server": "tsx tools/build-server.ts",
    "ui-smoke": "tsx tools/ui-smoke.ts",
    "lang-smoke": "tsx tools/lang-smoke.ts",
    "online-smoke": "tsx tools/online-smoke.ts",
    "deck-smoke": "tsx tools/deck-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
